{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["packages/**", "apps/**", "tools/**", "tests/**", "*.json", "!tests/*.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "html": { "linter": { "enabled": false }, "formatter": { "enabled": false } },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "correctness": { "noUndeclaredDependencies": "error" },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "Packages are flat directories: import another workspace package by its name and declare it in package.json."
                  },
                  {
                    "group": [
                      "@evolution-sdk/**",
                      "@meshsdk/**",
                      "@blaze-cardano/**",
                      "@cardano-sdk/**",
                      "@lucid-evolution/**",
                      "lucid-cardano",
                      "@emurgo/**",
                      "@dcspark/**",
                      "@harmoniclabs/cardano-ledger-ts",
                      "@harmoniclabs/plu-ts",
                      "@harmoniclabs/buildooor"
                    ],
                    "message": "Trust path (PD6): packages read transactions with the CBOR reader in @giveaway/chain and @noble; Cardano SDKs belong only to apps/web transaction building."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "Packages are flat directories: import another workspace package by its name and declare it in package.json."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**"],
                    "message": "Files in an app subdirectory (apps/api/src, apps/api/test) stay inside the app: import other workspace packages by name."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tools/**", "tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../packages/**", "../apps/**", "../spikes/**"],
                    "message": "Import workspace packages by name; spikes are never imported."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
