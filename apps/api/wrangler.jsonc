{
  // Local development only (`pnpm --filter @giveaway/api dev`); deployment belongs to MVP plan step 10.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giveaway-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_metrics": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // BR-05: Workers Logs record every invocation with its request URL (query included); they stay off. Checked by
  // tests/api-config.test.mjs.
  "observability": { "enabled": false },
  "vars": {
    // The only browser origin allowed to call the backend (BR-04): the local `make dev` server.
    "ALLOWED_ORIGIN": "http://127.0.0.1:4320"
  }
}
