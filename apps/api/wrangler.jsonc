{
  // Local development only (`pnpm --filter @giveaway/api dev`); deployment belongs to MVP plan step 10.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giveaway-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_metrics": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // BR-05: Workers Logs record every invocation with its request URL (query included); they stay off. Checked by
  // tests/core.test.mjs.
  "observability": { "enabled": false },
  "vars": {
    // The only browser origin allowed to call the backend (BR-04): the local `make dev` server.
    "ALLOWED_ORIGIN": "http://127.0.0.1:4320",
    // The indexer the upload gate reads server-side (apps/api/src/bundles.ts; not a route of this Worker): the local
    // Dolos dev chain (tools/devchain/dolos.toml).
    "INDEXER_URL": "http://127.0.0.1:3010"
  },
  // Hosting records (plan step 10). Locally Wrangler keeps them under .wrangler/state; no remote database is named
  // until deployment (MVP plan step 10). Migrations: `wrangler d1 migrations apply giveaway --local`.
  "d1_databases": [{ "binding": "DB", "database_name": "giveaway", "migrations_dir": "migrations" }],
  // Hosted bundle bytes, keyed bundles/<sha256 of the bytes>.
  "r2_buckets": [{ "binding": "BUNDLES", "bucket_name": "giveaway-bundles" }],
  // Per-client-address limit of the write routes (PUT, POST, DELETE; apps/api/src/index.ts `limited`). The Workers
  // Rate Limiting binding counts per Cloudflare location and approximately; the period can only be 10 or 60 seconds.
  // 20 writes a minute is an initial default (SELF-IMPOSED): an organizer's host, extend and delete are a few requests.
  // namespace_id is the account-scoped counter namespace; locally Miniflare keeps the counter in memory.
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // The HMAC key of owner-operation nonces (apps/api/src/auth.ts), a Worker secret: named here, never valued. `make api`
  // passes a non-secret development value (package.json `dev`), tests set their own (vitest.config.ts); the deployed
  // value is set at deployment (plan, deferred items).
  "secrets": { "required": ["NONCE_KEY"] },
  // Hourly sweep of expired hosting records (BR-08); reads check expires_at as well.
  "triggers": { "crons": ["17 * * * *"] }
}
